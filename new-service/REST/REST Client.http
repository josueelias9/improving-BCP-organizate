# Flow to create new document and extract transactions from it

@host = localhost:8000
@path = /shared_files/examples
@fileName = EECC102025_07750301.PDF
@documentUniqueIdentifier = ---PAGE1---EstadodeC__2025-10-01__bcp_debit

### 1. Create a new document

# @name postDocument
POST http://{{host}}/document HTTP/1.1
content-type: application/json

{
  "document_type": "bcp_debit",
  "pdf_filepath": "{{path}}/{{fileName}}",
  "user_email": "admin@bcpextractor.com"
}

### 2. Create transactions from the created document

POST http://{{host}}/transactions/{{postDocument.response.body.$.document_id}} HTTP/1.1
content-type: application/json

### 3. Export transactions to CSV

GET http://{{host}}/transactions/export?document_id={{postDocument.response.body.$.document_id}} HTTP/1.1
content-type: application/json

### 3. Export transactions to CSV

GET http://{{host}}/transactions/export?document_unique_identifier={{documentUniqueIdentifier}} HTTP/1.1
content-type: application/json



