###

# @name readAccounts
GET http://{{host}}/accounts HTTP/1.1

###

# @name createTransactions
POST http://{{host}}/accounts/{{readAccounts.response.body.$.accounts[2].id}}/transactions HTTP/1.1

###

# @name importTransactions
POST http://{{host}}/transactions/import?account_id={{readAccounts.response.body.$.accounts[2].id}} HTTP/1.1
content-type: application/json

###

# @name exportTransactions
GET http://{{host}}/transactions/export?account_id={{readAccounts.response.body.$.accounts[1].id}} HTTP/1.1

### temporal

# @name readDocuments
GET http://{{host}}/documents/ HTTP/1.1
content-type: application/json

###

DELETE http://{{host}}/documents/{{readDocuments.response.body.$.documents[1].id}} HTTP/1.1
content-type: application/json