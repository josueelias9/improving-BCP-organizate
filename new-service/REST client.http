### BCP PDF Extractor - REST Client Tests
### Variables
@baseUrl = http://127.0.0.1:8000
@outputInputDir = /workspace/new-service/examples

@outputFileName = transactions.csv

# docker compose:
# @outputInputDir = /downloads

### =================================================================== health.py

# @name getApiInfo
GET {{baseUrl}}/api
Accept: application/json

### =================================================================== document.py

# Get all documents from the database with their properties
# @name getAllDocuments
GET {{baseUrl}}/api/documents/?skip=0&limit=100
Accept: application/json

###

# Extract data from PDF and save it as JSON in the Documents table
# @name pdfProcessing_debit
POST {{baseUrl}}/api/pdf-processing
Content-Type: application/json

{
    "pdf_filename": "{{outputInputDir}}/EECC102025_07750301.PDF",
    "type": "bcp_debit",
    "user_email": "admin@bcpextractor.com"
}

###

# Extract data from PDF and save it as JSON in the Documents table
# @name pdfProcessing_credit
POST {{baseUrl}}/api/pdf-processing
Content-Type: application/json

{
    "pdf_filename": "{{outputInputDir}}/EECC102025_09745280.PDF",
    "type": "bcp_credit",
    "user_email": "admin@bcpextractor.com"
}

###

# Migrate data from the 'data' column of the document to the transactions table
# @name loadTransactionsFromDocument
POST {{baseUrl}}/api/load-from-document/{{pdfProcessing_credit.response.body.$.document_id}}
Accept: application/json

### =================================================================== category.py

# Get all categories from the database
# @name getAllCategories
GET {{baseUrl}}/api/categories/
Accept: application/json

### =================================================================== document_type.py

# Get all document types from the database
# @name getAllDocumentTypes
GET {{baseUrl}}/api/document-types/
Accept: application/json

### =================================================================== transaction.py

# Get all transactions with pagination
# @name getAllTransactions
GET {{baseUrl}}/api/transactions/?skip=0&limit=1000
Accept: application/json

###

# Update 'history' and/or 'category_name' fields of a specific transaction
# Only 'history' and 'category_name' fields can be edited
# If the category doesn't exist, only history will be updated
# @name updateTransactionById
PUT {{baseUrl}}/api/transactions/{{getAllTransactions.response.body.$[0].id}}
Content-Type: application/json

{
    "history": "This is a test history",
    "category_name": "Groceries"
}

###

# Update multiple transactions simultaneously
# Only 'history' and 'category_name' fields can be edited for each transaction
# If a category doesn't exist, only history will be updated for that transaction
# @name batchUpdateTransactions
PATCH {{baseUrl}}/api/transactions/batch
Content-Type: application/json

{
    "updates": [
        {
            "transaction_id": "{{getAllTransactions.response.body.$[1].id}}",
            "history": "This is the first test history",
            "category_name": "Food"
        },
        {
            "transaction_id": "{{getAllTransactions.response.body.$[2].id}}",
            "history": "This is the second test history",
            "category_name": "Utilities"
        }
    ]
}

###

# Export all transactions to CSV format
# File will be saved in the specified output directory (default: /shared_files/output)
# @name exportTransactionsCsv
GET {{baseUrl}}/api/transactions/export/csv?output_dir={{outputInputDir}}
Accept: application/json

###

# @name importTransactionsFromCsv
POST {{baseUrl}}/api/transactions/import/csv?csv_filename={{outputFileName}}&input_dir={{outputInputDir}}
Accept: application/json
